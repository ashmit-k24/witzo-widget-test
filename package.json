{
	"name": "witzo-chat-automation",
	"version": "1.0.0",
	"description": "Production-grade witzo chat automation system with TypeScript",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "tsx watch src/server.ts",
		"flush-chat-cache": "tsx flush-chat-cache.ts",
		"migrate": "tsx src/database/migrate.ts",
		"lint": "eslint . --ext .ts",
		"format": "prettier --write \"src/**/*.ts\"",
		"clean": "rm -rf dist",
		"pm2:start": "pm2 start ecosystem.config.js --env production",
		"pm2:dev": "pm2 start ecosystem.config.js --env development",
		"pm2:stop": "pm2 stop ecosystem.config.js",
		"pm2:restart": "pm2 restart ecosystem.config.js",
		"pm2:reload": "pm2 reload ecosystem.config.js",
		"pm2:delete": "pm2 delete ecosystem.config.js",
		"pm2:logs": "pm2 logs",
		"pm2:monit": "pm2 monit",
		"deploy": "npm run build && pm2 reload ecosystem.config.js --env production"
	},
	"keywords": [
		"authentication",
		"email",
		"nodejs",
		"postgresql",
		"typescript"
	],
	"author": "Witzo-AI",
	"license": "MIT",
	"dependencies": {
		"@langchain/core": "^1.1.39",
		"@langchain/textsplitters": "^1.0.1",
		"@paddle/paddle-node-sdk": "^3.6.0",
		"@pinecone-database/pinecone": "^6.1.3",
		"@types/ioredis": "^4.28.10",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.17",
		"axios": "^1.13.2",
		"bullmq": "^5.66.4",
		"cheerio": "^1.1.2",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"csv-parse": "^6.1.0",
		"dotenv": "^16.3.1",
		"exceljs": "^4.4.0",
		"express": "^4.18.2",
		"express-rate-limit": "^7.1.5",
		"express-validator": "^7.0.1",
		"helmet": "^7.1.0",
		"ioredis": "^5.9.1",
		"mammoth": "^1.11.0",
		"multer": "^2.0.2",
		"nodemailer": "^7.0.12",
		"openai": "^6.15.0",
		"papaparse": "^5.5.3",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"pdf-parse": "^2.4.5",
		"pg": "^8.11.3",
		"winston": "^3.11.0"
	},
	"devDependencies": {
		"@types/cheerio": "^0.22.35",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/multer": "^2.0.0",
		"@types/node": "^20.10.5",
		"@types/nodemailer": "^6.4.14",
		"@types/papaparse": "^5.5.2",
		"@types/pdf-parse": "^1.1.5",
		"@types/pg": "^8.10.9",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.33.0",
		"prettier": "^3.1.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.4",
		"typescript": "^5.3.3"
	},
	"pnpm": {
		"overrides": {
			"minimatch": "^10.2.1"
		}
	},
	"packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf"
}
