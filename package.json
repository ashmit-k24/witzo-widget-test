{
     "name": "email-auth-system-ts",
     "version": "1.0.0",
     "description": "Production-grade email authentication system with TypeScript",
     "main": "dist/server.js",
     "scripts": {
          "build": "tsc",
          "start": "node dist/server.js",
          "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
          "migrate": "ts-node src/database/migrate.ts",
          "lint": "eslint . --ext .ts",
          "format": "prettier --write \"src/**/*.ts\"",
          "clean": "rm -rf dist"
     },
     "keywords": [
          "authentication",
          "email",
          "nodejs",
          "postgresql",
          "typescript"
     ],
     "author": "",
     "license": "MIT",
     "dependencies": {
          "@pinecone-database/pinecone": "^6.1.3",
          "@types/passport": "^1.0.17",
          "@types/passport-google-oauth20": "^2.0.17",
          "axios": "^1.13.2",
          "cheerio": "^1.1.2",
          "cookie-parser": "^1.4.7",
          "cors": "^2.8.5",
          "csurf": "^1.2.2",
          "dotenv": "^16.3.1",
          "express": "^4.18.2",
          "express-rate-limit": "^7.1.5",
          "express-validator": "^7.0.1",
          "helmet": "^7.1.0",
          "nodemailer": "^7.0.12",
          "openai": "^6.15.0",
          "passport": "^0.7.0",
          "passport-google-oauth20": "^2.0.0",
          "pg": "^8.11.3",
          "winston": "^3.11.0"
     },
     "devDependencies": {
          "@types/cheerio": "^0.22.35",
          "@types/cookie-parser": "^1.4.10",
          "@types/cors": "^2.8.17",
          "@types/csurf": "^1.11.5",
          "@types/express": "^4.17.21",
          "@types/node": "^20.10.5",
          "@types/nodemailer": "^6.4.14",
          "@types/pg": "^8.10.9",
          "@typescript-eslint/eslint-plugin": "^6.15.0",
          "@typescript-eslint/parser": "^6.15.0",
          "eslint": "^8.56.0",
          "prettier": "^3.1.1",
          "ts-node": "^10.9.2",
          "ts-node-dev": "^2.0.0",
          "typescript": "^5.3.3"
     }
}
