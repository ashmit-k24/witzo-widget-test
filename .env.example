# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL_MODE=
# Set DB_SSL_MODE=require only when your Postgres server needs SSL.
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=10

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@yourapp.com
# Optional alias (supported): EMAIL_FROM_ADDRESS=noreply@yourapp.com

# Security Configuration
VERIFICATION_CODE_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=5
SESSION_EXPIRY_HOURS=24

# Rate Limiting (adjusted for high concurrency)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

JWT_SECRET=your-32-char-secret
JWT_REFRESH_SECRET=your-32-char-secret
COOKIE_SECRET=your-32-char-secret
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3001

# Widget Standalong Configuration
WIDGET_API_URL=http://localhost:3008
WIDGET_SCRIPT_URL=http://localhost:3008/widget/witzo-chat.js

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=website-scraper
PINECONE_HOST=
PINECONE_DIMENSION=1024
PINECONE_HYBRID=true

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MAX_TOKENS=1500
OPENAI_CHAT_TEMPERATURE=0.3
CHAT_HISTORY_WINDOW_MESSAGES=20
CHAT_SESSION_CACHE_MESSAGE_LIMIT=40
LLM_PROMPT_COST_PER_1K_USD=0
LLM_COMPLETION_COST_PER_1K_USD=0

# Razorpay Billing
RAZORPAY_KEY_ID=rzp_test_SNVaQHL9r6rte8
RAZORPAY_KEY_SECRET=EdLa6WtSWh66OxAM7eXXUEcc
RAZORPAY_WEBHOOK_SECRET=hey_this_is_a_test_webhook_secret

# Redis Configuration
# All Redis roles share the same host/port/password.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
# Optional legacy aliases. If you only set REDIS_CACHE_* values, the app will still use them.
# REDIS_CACHE_HOST=localhost
# REDIS_CACHE_PORT=6379
# REDIS_CACHE_USERNAME=
# REDIS_CACHE_PASSWORD=

# Scraper Configuration
SCRAPER_CONCURRENCY=10
SCRAPER_IGNORE_ROBOTS=false
SCRAPER_RENDER_SERVICE_URL=http://localhost:3002/content
SCRAPER_RENDER_SERVICE_TOKEN=change-me-render-token
SCRAPER_RENDER_SERVICE_MODE=browserless

# Firecrawl Configuration
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_API_URL=https://api.firecrawl.dev

# RAG / Reranking
COHERE_API_KEY=your_cohere_api_key
HYPE_QUESTIONS_PER_CHUNK=3
KNOWLEDGE_BOUNDARY=workspace_only

# Analytics Configuration
ANALYTICS_BUFFER_SIZE=5000
ANALYTICS_FLUSH_INTERVAL_MS=60000

# CORS Configuration
# Use explicit origins only, comma-separated if needed.
# Example: CORS_ORIGIN=http://localhost:3001,http://localhost:3010
CORS_ORIGIN=http://localhost:3001
