# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=10

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@yourapp.com
# Optional alias (supported): EMAIL_FROM_ADDRESS=noreply@yourapp.com

# Security Configuration
VERIFICATION_CODE_EXPIRY_MINUTES=10
MAX_VERIFICATION_ATTEMPTS=5
SESSION_EXPIRY_HOURS=24

# Rate Limiting (adjusted for high concurrency)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

JWT_SECRET=your-32-char-secret
JWT_REFRESH_SECRET=your-32-char-secret
COOKIE_SECRET=your-32-char-secret
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3001

# Widget Standalong Configuration
WIDGET_API_URL=http://localhost:3008
WIDGET_SCRIPT_URL=http://localhost:3008/widget/witzo-chat.js

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=website-scraper

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
CHAT_HISTORY_WINDOW_MESSAGES=30
CHAT_SESSION_CACHE_MESSAGE_LIMIT=40

# Redis Configuration (Scalability)
# Main Redis (backward compatibility)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Separate Redis Instances (for better scalability)
# If not set, will fall back to main REDIS_HOST/PORT/PASSWORD
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=

REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=

REDIS_ANALYTICS_HOST=localhost
REDIS_ANALYTICS_PORT=6379
REDIS_ANALYTICS_PASSWORD=

# Scraper Configuration
SCRAPER_CONCURRENCY=10

# Analytics Configuration
ANALYTICS_BUFFER_SIZE=5000
ANALYTICS_FLUSH_INTERVAL_MS=60000
